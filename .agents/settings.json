{
  "permissions": {
    "allow": [
      "command(git (status|diff|log).*)",
      "command(npm run (lint|test|build).*)",
      "command(pytest.*)",
      "command(ruff check.*)",
      "command(go test.*)",
      "command(cargo test.*)",
      "command(dotnet test.*)"
    ],
    "ask": [
      "command(npm install.*)",
      "command(pip install.*)",
      "command(composer install.*)"
    ],
    "deny": [
      "command(git (commit|push|tag|merge|rebase).*)",
      "command(gh (pr|release).*)",
      "command(npm publish.*)",
      "command(sudo.*)",
      "command(rm -rf.*)",
      "read_file(.env.*)",
      "read_file(secrets/)",
      "read_file(.*\\.(pem|key))",
      "write_file(.env.*)",
      "write_file(.git/)",
      "write_file(AGENTS.md)",
      "write_file(AGENT_POLICY.md)",
      "write_file(.claude/)",
      "write_file(.cursor/)",
      "write_file(.agents/)",
      "write_file(.github/workflows/)",
      "write_file(.github/scripts/)",
      "write_file(.github/CODEOWNERS)",
      "write_file(AUTONOMY.md)",
      "write_file(.devin/)",
      "write_file(.windsurf/)",
      "write_file(.coding-stuff/)",
      "write_file(.githooks/)",
      "write_file(install.sh)",
      "write_file(install.ps1)",
      "write_file(uninstall.sh)",
      "write_file(uninstall.ps1)",
      "write_file(ci.sh)"
    ]
  }
}
