#!/bin/bash
# ==============================================================================
# Git Hook: commit-msg
# Valide le format Conventional Commits : type(scope): description
# Types: feat, fix, chore, docs, refactor, test, ci, perf, build, style, revert
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}📝 COMMIT MESSAGE VALIDATION${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Récupère seulement la première ligne (ignore les commentaires Git)
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n1 | grep -v "^#")

# Ignorer si message vide (Git gérera l'annulation)
if [ -z "$FIRST_LINE" ]; then
    exit 0
fi

# Si le message commence par Merge, Skip, ou Revert standard
if [[ $FIRST_LINE =~ ^(Merge|Skip|Revert) ]]; then
    echo -e "${GREEN}✅ Auto-merge/skip commit detected, validation skipped${NC}"
    exit 0
fi

# Pattern Conventional Commits: type(scope): description
# Type: required
# Scope: optional
# Description: required (au moins 3 caractères)
PATTERN='^(feat|fix|chore|docs|refactor|test|ci|perf|build|style|revert)(\(.+\))?: .{3,}'

if ! echo "$FIRST_LINE" | grep -E "$PATTERN" > /dev/null 2>&1; then
    echo -e "${RED}❌ Le message de commit ne respecte pas le format Conventional Commits${NC}"
    echo ""
    echo -e "${YELLOW}Votre message :${NC}"
    echo "  $FIRST_LINE"
    echo ""
    echo -e "${YELLOW}Format requis :${NC}"
    echo "  type(scope): description"
    echo ""
    echo -e "${YELLOW}Types autorisés :${NC}"
    echo "  feat      - Nouvelle fonctionnalité"
    echo "  fix       - Correction de bug"
    echo "  chore     - Tâches de maintenance (dépendances, build)"
    echo "  docs      - Modifications de documentation"
    echo "  refactor  - Refactorisation de code sans modification fonctionnelle"
    echo "  test      - Ajout ou mise à jour de tests"
    echo "  ci        - Modifications de pipelines CI/CD"
    echo "  perf      - Amélioration de performance"
    echo "  build     - Système de build et packaging"
    echo "  style     - Formatage, style de code"
    echo "  revert    - Annulation d'un commit précédent"
    echo ""
    echo -e "${YELLOW}Exemples :${NC}"
    echo "  feat(gui): add video recording duration limit"
    echo "  fix(ocr): handle missing tesseract path on windows"
    echo "  docs(install): clarify winget installation steps"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Format Conventional Commit valide : $FIRST_LINE${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

exit 0
